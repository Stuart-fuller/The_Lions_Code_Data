   "source": [
    "x_feature = \"scoreCA\"\n",
    "y_feature = \"homepage\"\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 5))\n",
    "\n",
    "for label, colour in [(0, \"tab:red\"), (1, \"tab:blue\")]:\n",
    "    mask = y_train == label\n",
    "\n",
    "    ax.scatter(\n",
    "        X_train.loc[mask, x_feature],\n",
    "        X_train.loc[mask, y_feature],\n",
    "        label=class_names[label],\n",
    "        color=colour,\n",
    "        alpha=0.35,\n",
    "        s=12\n",
    "    )\n",
    "\n",
    "ax.set_xlabel(x_feature)\n",
    "ax.set_ylabel(y_feature)\n",
    "ax.legend()\n",
    "ax.set_ylim(0, 2000)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
