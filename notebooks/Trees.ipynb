     "text": [
      "Test accuracy: 0.867\n",
      "Recall (Withdrawn/Fail): 0.718\n",
      "Recall (Pass/Distinction): 0.935\n"
     ]
    }
   ],
   "source": [
    "tree_model = Pipeline([(\"preprocessor\", clone(preprocessor)),(\"classifier\", DecisionTreeClassifier(max_depth=7,min_samples_leaf=5, random_state=42))])\n",
    "\n",
    "tree_model.fit(X_train, y_train)\n",
    "y_pred_tree = tree_model.predict(X_test)\n",
    "\n",
    "tree_recall = recall_score(\n",
    "    y_test, y_pred_tree, labels=[0, 1], average=None, zero_division=0\n",
    ")\n",
    "\n",
    "print(f\"Test accuracy: {accuracy_score(y_test, y_pred_tree):.3f}\")\n",
    "print(f\"Recall (Withdrawn/Fail): {tree_recall[0]:.3f}\")\n",
    "print(f\"Recall (Pass/Distinction): {tree_recall[1]:.3f}\")\n"
   ]
  },
