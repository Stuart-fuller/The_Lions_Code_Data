   ],
   "source": [
    "X_fit, X_val, y_fit, y_val = train_test_split(X_train, y_train, test_size=0.25, random_state=42, stratify=y_train)\n",
    "\n",
    "depths = list(range(1, 21))\n",
    "training_accuracy = []\n",
    "validation_accuracy = []\n",
    "\n",
    "for depth in depths:\n",
    "    depth_tree = clone(tree_model)\n",
    "    depth_tree.set_params(classifier__max_depth=depth)\n",
    "    depth_tree.fit(X_fit, y_fit)\n",
    "\n",
    "    training_accuracy.append(depth_tree.score(X_fit, y_fit))\n",
    "    validation_accuracy.append(depth_tree.score(X_val, y_val))\n",
    "\n",
    "plt.figure(figsize=(9, 5))\n",
    "\n",
    "plt.plot(\n",
    "    depths, training_accuracy,\n",
    "    marker=\"o\", label=\"Training accuracy\"\n",
    ")\n",
    "plt.plot(\n",
    "    depths, validation_accuracy,\n",
    "    marker=\"o\", label=\"Validation accuracy\"\n",
    ")\n",
    "\n",
    "\n",
    "plt.axvline(\n",
    "    x=7,\n",
    "    color=\"red\",\n",
    "    linestyle=\"--\", label=\"Chosen depth = 7\")\n",
    "\n",
    "plt.xlabel(\"Maximum tree depth\")\n",
    "plt.ylabel(\"Accuracy\")\n",
    "plt.xticks(depths)\n",
    "plt.grid(alpha=0.25)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"elbow.png\", dpi = 90)\n",
    "plt.show()"
   ]
  },
