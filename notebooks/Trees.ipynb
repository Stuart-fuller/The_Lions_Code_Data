    "depths = [2, 5, 8, 10, 12, 15, 20]\n",
    "f1_by_depth = []\n",
    "\n",
    "for depth in depths:\n",
    "    candidate = clone(cv_model).set_params(classifier__max_depth=depth)\n",
    "\n",
    "    f1 = cross_validate(\n",
    "        candidate, X_train, y_train,\n",
    "        cv=cv, scoring=\"f1_macro\"\n",
    "    )[\"test_score\"]\n",
    "\n",
    "    f1_by_depth.append(f1.mean())\n",
    "\n",
    "plt.plot(depths, f1_by_depth, marker=\"o\")\n",
    "plt.axvline(10, color=\"red\", linestyle=\"--\", label=\"Current setting: 10\")\n",
    "plt.xticks(depths)\n",
    "plt.xlabel(\"Maximum tree depth\")\n",
    "plt.ylabel(\"Mean cross-validated macro F1\")\n",
    "plt.title(\"Effect of Maximum Tree Depth\")\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"mtd.png\", dpi = 90)\n",
    "plt.show()"
   ]
