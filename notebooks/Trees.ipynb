    "tree_counts = [1, 5, 10, 50, 100, 200, 300, 500]\n",
    "f1_by_size = []\n",
    "\n",
    "for n in tree_counts:\n",
    "    candidate = clone(cv_model).set_params(classifier__n_estimators=n)\n",
    "\n",
    "    f1 = cross_validate(\n",
    "        candidate, X_train, y_train,\n",
    "        cv=cv, scoring=\"f1_macro\"\n",
    "    )[\"test_score\"]\n",
    "\n",
    "    f1_by_size.append(f1.mean())\n",
    "\n",
    "plt.plot(tree_counts, f1_by_size, marker=\"o\")\n",
    "plt.axvline(50, color=\"red\", linestyle=\"--\", label=\"Current setting: 50\")\n",
    "plt.xscale(\"log\")\n",
    "plt.xticks(tree_counts, tree_counts)\n",
    "plt.xlabel(\"Number of trees (log scale)\")\n",
    "plt.ylabel(\"Mean cross-validated macro F1\")\n",
    "plt.title(\"Effect of the Number of Trees\")\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
